# ============================================================================
# HydroSim configuration. Two deployment shapes use this same file:
#
#   CLOUD (Coolify, sim.hydroteam.be)  — set the "always" block only.
#   SIM PC (Windows)                   — windows\install.ps1 generates .env
#                                        for you; this file is the reference.
# ============================================================================

# ---- always ----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Password for /admin (events, lap corrections).
ADMIN_PASSWORD=
# Bearer token for the collector and the sync relay. Same command as above.
API_TOKEN=
FLASK_DEBUG=0

# ---- cloud (Coolify) -------------------------------------------------------
# Behind Coolify's proxy: honour X-Forwarded-* and use https URLs/cookies.
#TRUST_PROXY=1
#PREFERRED_URL_SCHEME=https

# ---- sim PC (Windows) ------------------------------------------------------
#HOST=127.0.0.1
#PORT=8088
# 1 = /kiosk (name popup + driver picker) renders without an admin login.
# Only safe because the server binds 127.0.0.1.
#KIOSK_OPEN=1
# Where laps are relayed to. UPSTREAM_TOKEN = the cloud instance's API_TOKEN.
#UPSTREAM_URL=https://sim.hydroteam.be
#UPSTREAM_TOKEN=

# ---- optional --------------------------------------------------------------
#TIMEZONE=Europe/Brussels
#DATA_DIR=./data
